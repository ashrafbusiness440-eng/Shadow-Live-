rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isOwner() { return signedIn() && userDoc().data.role == 'owner'; }
    function hasCapability(capability) {
      return signedIn() && userDoc().data.adminEnabled == true
        && (isOwner() || (userDoc().data.capabilities is list && capability in userDoc().data.capabilities));
    }

    function publicIdTransitionAllowed(userId) {
      return (
          !('publicId' in resource.data)
          && !('publicId' in request.resource.data)
        )
        || (
          (!('publicId' in resource.data) || resource.data.publicId == null || resource.data.publicId == '')
          && request.resource.data.publicId is string
          && request.resource.data.publicId.matches('^[0-9]{6}$')
          && getAfter(/databases/$(database)/documents/public_ids/$(request.resource.data.publicId)).data.uid == userId
        )
        || (
          ('publicId' in resource.data)
          && ('publicId' in request.resource.data)
          && request.resource.data.publicId == resource.data.publicId
        );
    }

    function protectedUserFieldsUnchanged() {
      return (!('role' in resource.data) && !('role' in request.resource.data)
          || ('role' in resource.data) && ('role' in request.resource.data)
             && request.resource.data.role == resource.data.role)
        && (!('adminEnabled' in resource.data) && !('adminEnabled' in request.resource.data)
          || ('adminEnabled' in resource.data) && ('adminEnabled' in request.resource.data)
             && request.resource.data.adminEnabled == resource.data.adminEnabled)
        && (!('capabilities' in resource.data) && !('capabilities' in request.resource.data)
          || ('capabilities' in resource.data) && ('capabilities' in request.resource.data)
             && request.resource.data.capabilities == resource.data.capabilities)
        && (!('coins' in resource.data) && !('coins' in request.resource.data)
          || ('coins' in resource.data) && ('coins' in request.resource.data)
             && request.resource.data.coins == resource.data.coins)
        && (!('diamonds' in resource.data) && !('diamonds' in request.resource.data)
          || ('diamonds' in resource.data) && ('diamonds' in request.resource.data)
             && request.resource.data.diamonds == resource.data.diamonds)
        && (!('balance' in resource.data) && !('balance' in request.resource.data)
          || ('balance' in resource.data) && ('balance' in request.resource.data)
             && request.resource.data.balance == resource.data.balance)
        && (!('level' in resource.data) && !('level' in request.resource.data)
          || ('level' in resource.data) && ('level' in request.resource.data)
             && request.resource.data.level == resource.data.level)
        && (!('vipLevel' in resource.data) && !('vipLevel' in request.resource.data)
          || ('vipLevel' in resource.data) && ('vipLevel' in request.resource.data)
             && request.resource.data.vipLevel == resource.data.vipLevel)
        && (!('publicBadges' in resource.data) && !('publicBadges' in request.resource.data)
          || ('publicBadges' in resource.data) && ('publicBadges' in request.resource.data)
             && request.resource.data.publicBadges == resource.data.publicBadges)
        && (!('totalGiftsSent' in resource.data) && !('totalGiftsSent' in request.resource.data)
          || ('totalGiftsSent' in resource.data) && ('totalGiftsSent' in request.resource.data)
             && request.resource.data.totalGiftsSent == resource.data.totalGiftsSent)
        && (!('totalGiftsReceived' in resource.data) && !('totalGiftsReceived' in request.resource.data)
          || ('totalGiftsReceived' in resource.data) && ('totalGiftsReceived' in request.resource.data)
             && request.resource.data.totalGiftsReceived == resource.data.totalGiftsReceived)
        && (!('totalValueReceived' in resource.data) && !('totalValueReceived' in request.resource.data)
          || ('totalValueReceived' in resource.data) && ('totalValueReceived' in request.resource.data)
             && request.resource.data.totalValueReceived == resource.data.totalValueReceived)
        && (!('publicIdHistory' in resource.data) && !('publicIdHistory' in request.resource.data)
          || ('publicIdHistory' in resource.data) && ('publicIdHistory' in request.resource.data)
             && request.resource.data.publicIdHistory == resource.data.publicIdHistory)
        && (!('publicIdUpdatedAt' in resource.data) && !('publicIdUpdatedAt' in request.resource.data)
          || ('publicIdUpdatedAt' in resource.data) && ('publicIdUpdatedAt' in request.resource.data)
             && request.resource.data.publicIdUpdatedAt == resource.data.publicIdUpdatedAt)
        && (!('publicIdUpdatedBy' in resource.data) && !('publicIdUpdatedBy' in request.resource.data)
          || ('publicIdUpdatedBy' in resource.data) && ('publicIdUpdatedBy' in request.resource.data)
             && request.resource.data.publicIdUpdatedBy == resource.data.publicIdUpdatedBy);
    }

    function publicProfileAuthoritativeFieldsMatch(userId) {
      let source = get(/databases/$(database)/documents/users/$(userId)).data;
      return request.resource.data.level == source.get('level', 0)
        && request.resource.data.vipLevel == source.get('vipLevel', 0)
        && request.resource.data.badges == source.get('publicBadges', []);
    }

    function conversationParticipant(conversationId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.coins == 0
        && request.resource.data.diamonds == 0
        && (!('balance' in request.resource.data) || request.resource.data.balance == 0)
        && (!('level' in request.resource.data) || request.resource.data.level == 0)
        && (!('vipLevel' in request.resource.data) || request.resource.data.vipLevel == 0)
        && !('publicBadges' in request.resource.data)
        && !('totalGiftsSent' in request.resource.data)
        && !('totalGiftsReceived' in request.resource.data)
        && !('totalValueReceived' in request.resource.data)
        && !('publicId' in request.resource.data)
        && !('publicIdHistory' in request.resource.data)
        && !('publicIdUpdatedAt' in request.resource.data)
        && !('publicIdUpdatedBy' in request.resource.data);
      allow read: if signedIn() && (request.auth.uid == userId || hasCapability('viewUsers'));
      allow update: if signedIn() && request.auth.uid == userId
        && protectedUserFieldsUnchanged()
        && publicIdTransitionAllowed(userId);
      allow delete: if false;
    }

    match /admin_audit_logs/{logId} {
      allow read: if hasCapability('viewAuditLog');
      allow create, update, delete: if false;
    }

    match /financial_ledger/{entryId} {
      allow read: if isOwner() || hasCapability('manageEconomy') || hasCapability('manageSettlements');
      allow create, update, delete: if false;
    }

    match /system_config/{configId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /agency_settlements/{settlementId} {
      allow read: if hasCapability('manageSettlements') || hasCapability('manageAgencies');
      allow create, update, delete: if false;
    }

    match /public_profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.publicId == get(/databases/$(database)/documents/users/$(userId)).data.get('publicId', '')
        && request.resource.data.searchTokens is list
        && request.resource.data.searchTokens.size() <= 512
        && request.resource.data.interests is list
        && request.resource.data.interests.size() <= 30
        && request.resource.data.badges is list
        && request.resource.data.badges.size() <= 20
        && publicProfileAuthoritativeFieldsMatch(userId)
        && request.resource.data.keys().hasOnly([
          'uid','displayName','username','publicId','searchTokens','profileImageUrl','profileAvatarAsset',
          'coverImageUrl','bio','location','interests','level','vipLevel','badges','isOnline','createdAt','updatedAt'
        ]);
      allow delete: if false;
    }

    match /public_gift_showcases/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if false;

      match /items/{giftId} {
        allow read: if signedIn();
        allow create, update, delete: if false;
      }
    }

    match /public_ids/{publicId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && publicId.matches('^[0-9]{6}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','createdAt'])
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.publicId == publicId
        && !exists(/databases/$(database)/documents/public_ids/$(publicId))
        && !exists(/databases/$(database)/documents/room_ids/$(publicId));
      allow update, delete: if false;
    }

    match /room_ids/{publicId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['followerUid','followingUid','createdAt'])
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followingUid is string
        && request.resource.data.followingUid != request.auth.uid
        && followId == request.auth.uid + '__' + request.resource.data.followingUid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
    }

    match /gifts/{giftId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage','lastSenderId','updatedAt','unreadCounts'
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if conversationParticipant(conversationId);
        allow create: if conversationParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type == 'text'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }
  }
}