class _LoginScreenState extends State<LoginScreen> {
  final _phoneController = TextEditingController();
  final List<TextEditingController> _otpControllers =
      List.generate(6, (_) => TextEditingController());
  final List<FocusNode> _otpFocus = List.generate(6, (_) => FocusNode());

  String _countryCode = '+971';
  String? _verificationId;
  bool _otpPage = false;

  static const _gold = Color(0xFFFFD54A);
  static const _purple = Color(0xFF8500FF);
  static const _pink = Color(0xFFE000FF);

  @override
  void dispose() {
    _phoneController.dispose();

    for (final controller in _otpControllers) {
      controller.dispose();
    }

    for (final focus in _otpFocus) {
      focus.dispose();
    }

    super.dispose();
  }

  String get _fullPhone {
    var phone = _normalizeDigits(_phoneController.text.trim());

    // حذف الصفر المحلي من بداية الرقم:
    // 0501234567 و 501234567 => نفس الرقم بعد إضافة كود الدولة.
    phone = phone.replaceFirst(RegExp(r'^0+'), '');

    return '$_countryCode$phone';
  }

  String _normalizeDigits(String value) {
    const arabic = '٠١٢٣٤٥٦٧٨٩';
    const persian = '۰۱۲۳۴۵۶۷۸۹';
    const english = '0123456789';

    final buffer = StringBuffer();

    for (final char in value.split('')) {
      final a = arabic.indexOf(char);
      final p = persian.indexOf(char);

      if (a != -1) {
        buffer.write(english[a]);
      } else if (p != -1) {
        buffer.write(english[p]);
      } else if (RegExp(r'[0-9]').hasMatch(char)) {
        buffer.write(char);
      }
    }

    return buffer.toString();
  }

  void _handleOtpInput(int index, String rawValue) {
    final value = _normalizeDigits(rawValue);

    // إذا تم لصق كود كامل أو عدة أرقام
    if (value.length > 1) {
      final digits = value.length > 6 ? value.substring(0, 6) : value;

      for (var i = 0; i < 6; i++) {
        _otpControllers[i].text = i < digits.length ? digits[i] : '';
      }

      final target = digits.length >= 6 ? 5 : digits.length;
      _otpFocus[target].requestFocus();
      setState(() {});
      return;
    }

    if (value.isEmpty) {
      _otpControllers[index].clear();

      if (index > 0) {
        _otpFocus[index - 1].requestFocus();
      }

      setState(() {});
      return;
    }

    _otpControllers[index].value = TextEditingValue(
      text: value,
      selection: TextSelection.collapsed(offset: value.length),
    );

    if (index < 5) {
      _otpFocus[index + 1].requestFocus();
    }

    setState(() {});
  }

  String get _otp =>
      _otpControllers.map((controller) => controller.text).join();

  void _sendOtp() {
    final phone = _phoneController.text.trim();

    if (phone.length < 7) {
      _showMessage('أدخل رقم هاتف صحيح');
      return;
    }

    context.read<AuthBloc>().add(
          PhoneAuthRequested(_fullPhone),
        );
  }

  void _verifyOtp() {
    if (_verificationId == null) {
      _showMessage('لم يتم إرسال رمز التحقق بعد');
      return;
    }

    if (_otp.length != 6) {
      _showMessage('أدخل رمز التحقق المكوّن من 6 أرقام');
      return;
    }

    context.read<AuthBloc>().add(
          PhoneCodeSubmitted(
            _verificationId!,
            _otp,
          ),
        );
  }

  void _showMessage(String text) {
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text(text)),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Directionality(
      textDirection: TextDirection.rtl,
      child: Scaffold(
        backgroundColor: const Color(0xFF03050D),
        body: BlocConsumer<AuthBloc, AuthState>(
          listener: (context, state) {
            if (state is AuthError) {
              _showMessage(state.message);
            }

            if (state is PhoneCodeSent) {
              setState(() {
                _verificationId = state.verificationId;
                _otpPage = true;
              });

              Future.delayed(
                const Duration(milliseconds: 250),
                () {
                  if (mounted) {
                    _otpFocus.first.requestFocus();
                  }
                },
              );
            }

            if (state is Authenticated) {
              Navigator.of(context).pushNamedAndRemoveUntil(
                '/main',
                (route) => false,
              );
            }
          },
          builder: (context, state) {
