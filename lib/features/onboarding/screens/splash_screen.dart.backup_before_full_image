import 'dart:async';
import 'package:flutter/material.dart';
import '../../../services/navigation_service.dart';

class SplashScreen extends StatefulWidget {
  const SplashScreen({super.key});

  @override
  State<SplashScreen> createState() => _SplashScreenState();
}

class _SplashScreenState extends State<SplashScreen> {
  @override
  void initState() {
    super.initState();

    Timer(const Duration(seconds: 3), () {
      if (!mounted) return;
      Navigator.of(context).pushReplacementNamed(AppRoutes.onboarding);
    });
  }

  @override
  Widget build(BuildContext context) {
    final size = MediaQuery.sizeOf(context);

    return Scaffold(
      backgroundColor: const Color(0xFF03040B),
      body: Stack(
        fit: StackFit.expand,
        children: [
          // الخلفية
          Image.asset(
            'assets/images/splash_bg.png',
            fit: BoxFit.cover,
            alignment: Alignment.center,
          ),

          // طبقة داكنة لضمان وضوح الشعار والنص
          Container(
            decoration: const BoxDecoration(
              gradient: LinearGradient(
                begin: Alignment.topCenter,
                end: Alignment.bottomCenter,
                colors: [
                  Color(0x22000000),
                  Color(0x00000000),
                  Color(0x22000000),
                  Color(0x66000000),
                ],
                stops: [0.0, 0.42, 0.75, 1.0],
              ),
            ),
          ),

          SafeArea(
            child: Padding(
              padding: EdgeInsets.symmetric(
                horizontal: size.width * 0.08,
              ),
              child: Column(
                children: [
                  SizedBox(height: size.height * 0.10),

                  // شعار Shadow Live
                  _buildLogo(size),

                  SizedBox(height: size.height * 0.025),

                  const Text(
                    'صوت يجمعنا',
                    textDirection: TextDirection.rtl,
                    textAlign: TextAlign.center,
                    style: TextStyle(
                      color: Colors.white,
                      fontSize: 24,
                      height: 1.2,
                      fontWeight: FontWeight.w800,
                      shadows: [
                        Shadow(
                          color: Colors.black87,
                          blurRadius: 10,
                        ),
                      ],
                    ),
                  ),

                  const Spacer(),

                  const Text(
                    'أكثر من صوت ..\nمجتمع كامل',
                    textDirection: TextDirection.rtl,
                    textAlign: TextAlign.center,
                    style: TextStyle(
                      color: Colors.white,
                      fontSize: 27,
                      height: 1.45,
                      fontWeight: FontWeight.w800,
                      shadows: [
                        Shadow(
                          color: Colors.black,
                          blurRadius: 12,
                        ),
                      ],
                    ),
                  ),

                  SizedBox(height: size.height * 0.065),

                  // شريط التحميل
                  TweenAnimationBuilder<double>(
                    tween: Tween(begin: 0.0, end: 1.0),
                    duration: const Duration(seconds: 3),
                    builder: (context, value, _) {
                      return Container(
                        width: size.width * 0.52,
                        height: 6,
                        decoration: BoxDecoration(
                          borderRadius: BorderRadius.circular(99),
                          color: Colors.white24,
                        ),
                        alignment: Alignment.centerLeft,
                        child: FractionallySizedBox(
                          widthFactor: value,
                          child: Container(
                            decoration: BoxDecoration(
                              borderRadius: BorderRadius.circular(99),
                              gradient: const LinearGradient(
                                colors: [
                                  Color(0xFFFFD84D),
                                  Color(0xFFFF4FD8),
                                  Color(0xFF7A2CFF),
                                ],
                              ),
                              boxShadow: const [
                                BoxShadow(
                                  color: Color(0x997A2CFF),
                                  blurRadius: 12,
                                ),
                              ],
                            ),
                          ),
                        ),
                      );
                    },
                  ),

                  const SizedBox(height: 15),

                  const Text(
                    'جار التحميل...',
                    textDirection: TextDirection.rtl,
                    style: TextStyle(
                      color: Colors.white,
                      fontSize: 17,
                      fontWeight: FontWeight.w700,
                    ),
                  ),

                  SizedBox(height: size.height * 0.045),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildLogo(Size size) {
    final logoSize = (size.width * 0.28).clamp(100.0, 150.0);

    return Column(
      children: [
        Stack(
          clipBehavior: Clip.none,
          alignment: Alignment.center,
          children: [
            Container(
              width: logoSize,
              height: logoSize,
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                color: const Color(0x771A073D),
                border: Border.all(
                  color: const Color(0xFFFFD84D),
                  width: 4,
                ),
                boxShadow: const [
                  BoxShadow(
                    color: Color(0xAA9A19FF),
                    blurRadius: 35,
                    spreadRadius: 4,
                  ),
                  BoxShadow(
                    color: Color(0x66FF2BD6),
                    blurRadius: 50,
                    spreadRadius: 8,
                  ),
                ],
              ),
              child: Icon(
                Icons.mic_rounded,
                size: logoSize * 0.55,
                color: const Color(0xFFFFD84D),
              ),
            ),
            Positioned(
              top: -30,
              child: Icon(
                Icons.workspace_premium_rounded,
                size: logoSize * 0.43,
                color: const Color(0xFFFFD84D),
              ),
            ),
          ],
        ),
        const SizedBox(height: 22),
        const Text(
          'SHADOW',
          textAlign: TextAlign.center,
          style: TextStyle(
            color: Color(0xFFFFD84D),
            fontSize: 38,
            fontWeight: FontWeight.w900,
            letterSpacing: 3,
            height: 0.95,
            shadows: [
              Shadow(
                color: Color(0xAAFF24D8),
                blurRadius: 12,
              ),
            ],
          ),
        ),
        const Text(
          'LIVE',
          textAlign: TextAlign.center,
          style: TextStyle(
            color: Color(0xFFFFD84D),
            fontSize: 36,
            fontWeight: FontWeight.w900,
            letterSpacing: 5,
            height: 1.05,
          ),
        ),
      ],
    );
  }
}
