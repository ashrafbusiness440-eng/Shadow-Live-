{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --no-audit --no-fund && git clone --depth 1 --branch 3.47.2 https://github.com/flutter/flutter.git /tmp/flutter && /tmp/flutter/bin/flutter config --enable-web && /tmp/flutter/bin/flutter pub get",
  "buildCommand": "/tmp/flutter/bin/flutter build web --release --target lib/main.dart",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/api/economy-control",
      "destination": "/api/economy-router?route=economy-control"
    },
    {
      "source": "/api/gift-catalog",
      "destination": "/api/economy-router?route=gift-catalog"
    },
    {
      "source": "/api/gift-economy-config",
      "destination": "/api/economy-router?route=gift-economy-config"
    },
    {
      "source": "/api/recharge-config",
      "destination": "/api/economy-router?route=recharge-config"
    }
  ]
}
